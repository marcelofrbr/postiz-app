# Misc Settings
OPENAI_API_KEY=""
# OAuth client configured for the ChatGPT app. Only this client can receive
# verified user email claims for ChatGPT Enterprise domain restrictions.
OPENAI_OAUTH_CLIENT_ID=""
# Client id of the OAuth app (Settings > Developers) that HubSpot agents
# connect with. HubSpot sends no client secret, so this one app uses PKCE
# instead, gets a refresh token, and the MCP backend answers OAuth discovery
# at its domain root. Set it on both the API and the MCP backend.
# HUBSPOT_OAUTH_CLIENT_ID=""
# Client id and secret of the HubSpot app itself (HubSpot project > app >
# Auth tab), not of the Postiz app above. Its redirect URL is
# <NEXT_PUBLIC_BACKEND_URL>/oauth/hubspot/callback, which finishes the install
# (HubSpot only counts it once the code is exchanged). Set them on the API.
# HUBSPOT_APP_CLIENT_ID=""
# HUBSPOT_APP_CLIENT_SECRET=""
# MCP OAuth Dynamic Client Registration (RFC 7591) redirect-domain allowlist.
# When set (comma separated), POST /oauth/register only accepts redirect_uris
# whose host matches a listed domain or one of its subdomains; unset or empty
# means any client can self-register. Only https callbacks are checked:
# loopback (http://localhost:8787/callback - Grok, Claude Code) and
# private-use scheme callbacks (cursor://...) stay on the user's machine
# and are always accepted. Example locks web callbacks to the claude.ai
# connector; add cursor.com for Cursor.
# DCR_VERIFIED_DOMAINS="claude.ai,claude.com"
# Postiz Cloud only: lets people connect a self-hosted Postiz on the MCP
# consent screen ("Use self-hosted"). The MCP tool calls of that connection
# are relayed to the instance with its API key. Leave unset on self-hosted
# installs; set it on both the API and the MCP backend.
# MCP_SELF_HOSTED_RELAY=true
# EVOLINK_API_KEY="" # EvoLink API key for Seedance AI video generation (https://evolink.ai)

# === AI Settings
#
# A configuracao principal de IA agora e per-workspace via UI:
# Settings > AI Models permite cadastrar chave (OpenRouter ou OpenAI),
# escolher modelo e opcoes para cada tipo (Texto, Imagem, Video, Web Search).
# As chaves sao armazenadas criptografadas (AES-256-GCM com ENCRYPTION_KEY)
# no banco. Ver docs/architecture/ai-provider-system.md.
#
# As env vars abaixo sao opcionais — usadas apenas em features dormentes
# (HeyGen, ImageSlides) ou como fallback de catalogo. Nao sao mais
# pre-requisito para o agente, gerador de posts ou geracao de imagem.

## OpenAI (opcional — usado pelo HeyGen para TTS e pelo ImageSlides
##         para quebrar tema em slides; nao usado pelo agente nem pela
##         geracao de imagem do composer, esses respeitam Settings > AI Models)

## FAL (geracao de imagens alternativa via Ideogram v2 — usado pelo ImageSlides)
#FAL_KEY=""

## KIE.AI — DEPRECATED env var. A geracao de video agora le credencial
## per-workspace de Settings > AI Models > Video (Seedance 2.0, Veo 3.1).
## Esta variavel nao e mais lida; mantida apenas como referencia historica.
#KIEAI_API_KEY=""

## ElevenLabs (text-to-speech para narracao de slides)
#ELEVENSLABS_API_KEY=""

## Transloadit (montagem de video a partir de slides)
#TRANSLOADIT_AUTH=""
#TRANSLOADIT_SECRET=""
#TRANSLOADIT_TEMPLATE=""

## Tavily (web search — pode ser configurado em Settings > AI Models > Web Search,
##         esta env serve apenas como fallback de teste em dev)
#TAVILY_API_KEY=""

## MCP Server (URL publica do servidor MCP — expoe o agente para clientes externos)
#MCP_URL=""

## Agent API (chaves de acesso para agente e media SSO)
#AGENT_API_KEY=""
#AGENT_MEDIA_SSO_KEY=""

NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""

# URL do Temporal Web UI (opcional) — habilita os links "Temporal" de depuracao
# na area Status (abas Problemas e Historico). Sem isto, os demais links (post,
# automacao) continuam funcionando; so o atalho para o Temporal fica oculto.
#NEXT_PUBLIC_TEMPORAL_WEB_URL="http://localhost:8233"
#NEXT_PUBLIC_TEMPORAL_NAMESPACE="default"

# Aba "Saude da infra" (Status): sonda ativa de PostgreSQL/Redis/Temporal/
# Storage/Email. HABILITADA POR DEFAULT (so "false" desabilita).
# SEGURANCA: o resultado e GLOBAL (infra compartilhada da instancia) e fica
# atras do guard admin-de-ORG. Como o auto-registro concede admin na propria
# org, numa instalacao de REGISTRO ABERTO qualquer auto-registrado veria o
# status/latencia/provider da infra (nunca credenciais). Se o registro for
# aberto e voce nao quer essa exposicao, defina "false" — ou mantenha
# DISABLE_REGISTRATION=true (recomendado para instancia controlada/agencia).
#STATUS_INFRA_HEALTH_ENABLED="false"

# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# Protecao SSRF para chamadas de providers, downloads de midia e webhooks de
# saida. Fica ATIVA por padrao e bloqueia localhost, metadata e redes privadas
# no lookup usado pela conexao (Undici e Axios), inclusive apos redirect.
# Defina true SOMENTE se esta instancia self-hosted precisar acessar providers
# ou webhooks HTTPS em uma rede privada confiavel. O opt-out e amplo para os
# usuarios autenticados da instancia; uploads/importacoes publicas por URL
# continuam com a protecao obrigatoria mesmo quando esta variavel esta ativa.
#DISABLE_SSRF_PROTECTION=false

# === Temporal (obrigatorio para orchestrator/agendamento)
#TEMPORAL_ADDRESS="localhost:7233"
#TEMPORAL_NAMESPACE="default"
#TEMPORAL_API_KEY=""
#TEMPORAL_TLS="false"
# Divide a concorrencia de activities de cada provider entre varios containers.
# Use o mesmo divisor em todos; filas com limite 1 devem ficar em um unico
# container usando EXCLUDE_QUEUE nos demais.
#WORKER_CONCURRENCY_DIVIDER="1"
# Lista exata, separada por virgulas, de filas de provider que este container
# nao deve consumir. A fila main contem todos os workflows e nao pode ser
# excluida.
#EXCLUDE_QUEUE=""
# Filas com poller de workflow que /health/workers deve monitorar. Todos os
# workflows atuais usam main.
#TEMPORAL_HEALTH_TASK_QUEUES="main"
# Filas de provider que /health/workers deve consultar como pollers de activity.
# Configure apenas filas que precisam estar ativas nesta instalacao/container.
#TEMPORAL_HEALTH_ACTIVITY_TASK_QUEUES="facebook,instagram"
# Workflow V112 fica desativado por padrao. Ative primeiro por ID exato de
# integracao; depois, opcionalmente, por provider. O gate global so deve ser
# usado apos os canarios e smoke tests do ADR. Zernio permanece sempre em V102.
#POST_WORKFLOW_V113_INTEGRATION_IDS=""
#POST_WORKFLOW_V113_PROVIDERS=""
#POST_WORKFLOW_V113_ALL="false"

