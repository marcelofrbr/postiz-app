# Modo de creditos de IA
# "unlimited" = sem limites para todos (default para self-hosted)
# "managed"  = creditos gerenciados por perfil (modo SaaS/agencia)
AI_CREDITS_MODE="unlimited"

# Limites default por perfil quando AI_CREDITS_MODE="managed"
# -1 = ilimitado (default), 0 = bloqueado, N = quantidade mensal
#AI_CREDITS_DEFAULT_IMAGES=50
#AI_CREDITS_DEFAULT_VIDEOS=10

# Knowledge Base (RAG) — requer imagem Postgres com pgvector
# Default: true. Defina "false" para desabilitar upload de documentos e tool knowledgeBaseQuery.
ENABLE_KNOWLEDGE_BASE="true"

# Chave mestra para criptografia de credenciais (separada do JWT_SECRET)
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# Os tokens de acesso dos canais (Integration.token/refreshToken) sao
# criptografados em repouso por PADRAO (AES-256-GCM, mesma ENCRYPTION_KEY das
# credenciais). Voce NAO precisa configurar nada. Freio de emergencia OPCIONAL:
# setar =true faz novas escritas voltarem a texto puro (os ja cifrados seguem
# sendo lidos normalmente). Nao troque a ENCRYPTION_KEY (quebra a descriptografia).
# DISABLE_INTEGRATION_TOKEN_ENCRYPTION=true

# Intervalo (em horas) do refresh proativo em lote dos tokens dos canais — um
# workflow Temporal unico (refresh-tokens-cron) renova todo canal cujo token
# expira em ate ~1 dia, evitando que o canal caia em silencio. Auto-iniciado no
# boot, nao precisa de cron externo. Padrao: 24.
# TOKEN_REFRESH_INTERVAL_HOURS=24

# Token de Usuario do Sistema (Meta Business Manager) — fallback instance-wide
# do SELF-HEAL de publicacao Facebook/Instagram: quando o token OAuth humano e
# invalidado pela Meta (checkpoint de seguranca da conta), o app re-deriva o
# Page Access Token via System User (que nao tem sessao humana e nunca expira)
# em vez de desconectar o canal. Preferencia: Settings > Credenciais >
# Instagram > Token Usuario do Sistema (por perfil, com heranca do Default);
# esta env e o ultimo degrau da cadeia. Gere em Business Settings > System
# Users com escopos pages_manage_posts, pages_read_engagement, pages_show_list,
# instagram_basic, instagram_content_publish, business_management e atribua as
# Paginas/Instagrams ao usuario do sistema.
# ATENCAO (multi-org): o fallback e INSTANCE-WIDE — em instancias que hospedam
# organizacoes NAO relacionadas, toda org sem token proprio tentara curar com o
# Business Manager do operador (a cura so funciona para Paginas que o proprio
# BM gerencia, mas o comportamento compartilhado pode nao ser o desejado). Em
# instancia multi-org, prefira configurar por workspace na UI e deixe esta env
# vazia.
# META_SYSTEM_USER_TOKEN=""
